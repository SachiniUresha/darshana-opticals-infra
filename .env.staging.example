# ==============================================================================
# OSMS Staging Environment Variable Contract (.env.staging.example)
#
# IMPORTANT:
# - This template defines the authoritative staging configuration contract.
# - NEVER commit real credentials, connection secrets, or keys to version control.
# - In staging, values must be provisioned through secure platform mechanisms:
#     * Backend: AWS App Runner Environment Variables / Secrets
#     * Frontend: Vercel Project Environment Variables (Staging Environment)
#     * CI/CD: GitHub Actions Secrets & Environment Variables (Sprint 3 Issues #9, #10)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Runtime Configuration (AWS App Runner)
# ------------------------------------------------------------------------------
NODE_ENV=staging
PORT=5000

# Staging Frontend URL allowed for CORS (Strict HTTPS origin, no trailing slash)
CORS_ORIGIN=https://osms-frontend-staging.vercel.app

# MongoDB Atlas Staging Database Connection (Replica Set required for transactions)
# Format: mongodb+srv://<username>:<password>@<staging-cluster>.mongodb.net/osms-staging?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://staging_app_user:placeholder_staging_password@cluster-staging.example.mongodb.net/osms-staging?retryWrites=true&w=majority

# Must match the exact database name specified in MONGODB_URI for index gates
MONGODB_DATABASE=osms-staging

# Staging JWT Configuration (Production-like entropy, dedicated staging secret)
JWT_SECRET=placeholder-staging-jwt-secret-minimum-32-chars-long
JWT_EXPIRES_IN=24h

# ------------------------------------------------------------------------------
# 2. External Third-Party Integrations (Staging / Sandbox Modes Only)
# ------------------------------------------------------------------------------
# Payment Gateway Sandbox Configuration (Zero real currency charges)
PAYMENT_GATEWAY_MODE=sandbox
PAYMENT_MERCHANT_ID=placeholder_staging_merchant_id
PAYMENT_SECRET_KEY=placeholder_staging_merchant_secret

# Notification Provider Safety (Routes all notifications to safe test sink/mailtrap)
NOTIFICATION_PROVIDER=sandbox
NOTIFICATION_TEST_RECIPIENT=uat.notifications@osms.local
NOTIFICATION_API_KEY=placeholder_staging_notification_key

# Chatbot AI Provider Configuration (Dedicated staging quota/rate-limited key)
CHATBOT_API_KEY=placeholder_staging_chatbot_key
CHATBOT_PROVIDER_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 3. Frontend Build Configuration (Vercel Staging Environment)
# ------------------------------------------------------------------------------
# HTTPS API base URL pointing to the deployed AWS App Runner staging backend
VITE_API_BASE_URL=https://placeholder-staging-backend.awsapprunner.com/api

# ------------------------------------------------------------------------------
# 4. Infrastructure & Deployment Metadata (Reference for CI/CD)
# ------------------------------------------------------------------------------
AWS_REGION=ap-southeast-1
AWS_APP_RUNNER_SERVICE_NAME=osms-backend-staging
ECR_REPOSITORY_NAME=osms-backend
IMAGE_TAG_PREFIX=staging
