# OSMS staging configuration contract (infra #4)
# NON-SECRET EXAMPLE ONLY. Do not load this file directly into any environment.
# Reserved .example URLs are fictional and intentionally non-deployable.
# Empty sensitive values must be injected by the owning platform secret store.
# Keep development, staging and production resources and credentials separate.

# --- Backend runtime ---
# Staging uses production-like backend behavior; the resource boundary identifies it as staging.
NODE_ENV=production
# Must match the reviewed App Runner container/service port.
PORT=5000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
REQUEST_BODY_LIMIT=10kb
# Must identify a fictional branch created only for staging.
ONLINE_FULFILLMENT_BRANCH_CODE=STAGING_DEMO_BRANCH

# --- Frontend staging API ---
# Replace only with the exact approved staging backend HTTPS API base.
VITE_API_BASE_URL=https://osms-staging-api.example/api

# --- MongoDB Atlas ---
# REQUIRED SECRET: inject an Atlas staging URI that selects only the dedicated osms-staging database.
# The cluster must support transactions. Never reuse development or production users or data.
MONGODB_URI=

# --- Authentication and CORS ---
# REQUIRED SECRET: inject a unique, high-entropy staging JWT signing secret.
JWT_SECRET=
JWT_EXPIRES_IN=24h
# Replace both values with the same exact approved Vercel staging HTTPS origin.
# Never use localhost, a production origin or wildcard CORS.
FRONTEND_ORIGIN=https://osms-staging-frontend.example
FRONTEND_URL=https://osms-staging-frontend.example

# --- PayHere sandbox ---
PAYMENT_CURRENCY=LKR
PAYHERE_MODE=sandbox
# REQUIRED SECRETS: inject credentials from a staging-only PayHere sandbox account.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Replace only with approved staging HTTPS routes and register them in the sandbox account.
PAYHERE_RETURN_URL=https://osms-staging-frontend.example/payments/return
PAYHERE_CANCEL_URL=https://osms-staging-frontend.example/payments/cancel
PAYHERE_NOTIFY_URL=https://osms-staging-api.example/api/payments/notify
PAYHERE_NOTIFY_RATE_LIMIT_WINDOW_MS=60000
PAYHERE_NOTIFY_RATE_LIMIT_MAX=600
# Optional sandbox retrieval API credentials; leave empty when unused.
PAYHERE_API_APP_ID=
PAYHERE_API_APP_SECRET=
PAYHERE_RETRIEVAL_TIMEOUT_MS=8000

# --- Cloudinary ---
# Use a staging-separated cloud/account and synthetic images only.
CLOUDINARY_CLOUD_NAME=osms-staging-example
# REQUIRED SECRETS when Cloudinary is enabled: inject through the platform secret store.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Chatbot ---
# REQUIRED SECRET: inject a staging-specific provider key with a controlled quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
CHATBOT_RATE_LIMIT_WINDOW_MS=60000
CHATBOT_RATE_LIMIT_MAX=10
CHATBOT_TIMEOUT_MS=6000

# --- Notifications ---
# Delivery is disabled by default. Keep SMTP connection credentials empty until separately approved.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Reserved senders and links are non-deployable placeholders, not verified identities.
EMAIL_FROM=OSMS Staging <noreply@notifications.example>
SES_FROM_EMAIL=OSMS Staging <noreply@notifications.example>
TRACKING_PORTAL_BASE_URL=https://osms-staging-frontend.example
# Do not rely on this redirect: NODE_ENV=production does not activate the existing staging branch.
STAGING_NOTIFICATION_RECIPIENT=
# Real delivery requires separate authorization, a controlled provider and verified test recipients.

# --- Operational chatbot TTL prerequisites (infra #7) ---
# Must exactly match the database selected by the TTL job's separately injected MONGODB_URI.
OSMS_TARGET_DATABASE=osms-staging
# Safe default is read-only verification. Use apply only in a reviewed provisioning job.
# Use smoke only with the isolated empty *_ttl_smoke database required by the infra #7 runbook.
OSMS_CHATBOT_INDEX_MODE=verify
# This contract does not replace docs/chatbot-usage-ttl.md or prove staging index provisioning.
